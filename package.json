{
  "name": "amitkkae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit": "npx ts-node amitkk/audit.js",
    "clean": "npx rimraf node_modules .next package-lock.json && npm cache clean --force && npm install rimraf --save-dev && npm install",
    "predev_correct": "npx ts-node -r dotenv/config amitkk/generateComponentMap.js",
    "predev": "npx ts-node -r dotenv/config amitkk/generateComponentMap.js",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --turbo",
    "build": "npm run predev && cross-env NODE_OPTIONS='--max-old-space-size=8192' next build",
    "dev-1": "next dev",
    "dev-x": "next dev",
    "start": "next start",
    "git": "git add . && git commit -a -m `commit` && git push",
    "dit": "git add . && git commit -a -m `commit` && git push",
    "deploy": "node gitpush.js",
    "deps": "sh install-packages.sh",
    "build_live": "bash deploy_live.sh",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint pages amitkk lib components --ext .ts,.tsx --fix",
    "lint:strict": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint pages amitkk lib pages --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx .",
    "check": "npm run typecheck && npm run circular && npm run lint",
    "check:strict": "npm run circular && npm run typecheck && npm run lint:strict"
  },
  "browserslist": {
    "production": [
      "chrome >= 90",
      "edge >= 90",
      "firefox >= 90",
      "safari >= 15",
      "ios_saf >= 15"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
